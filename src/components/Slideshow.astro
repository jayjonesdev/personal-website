---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Slide {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}
interface Props {
  images: Slide[];
  label?: string;
}
const { images, label = 'Photo gallery' } = Astro.props;
const single = images.length <= 1;
---

<figure class="slideshow" role="group" aria-roledescription="carousel" aria-label={label}>
  <div
    class="ss-stage"
    tabindex="0"
    aria-label={`${label}. Use the left and right arrow keys to move between photos.`}
  >
    {
      images.map((img, i) => (
        <div
          class:list={['ss-slide', { 'is-active': i === 0 }]}
          data-caption={img.caption ?? ''}
          aria-hidden={i === 0 ? 'false' : 'true'}
        >
          <Image
            src={img.src}
            alt={img.alt}
            widths={[640, 960, 1400]}
            sizes="(max-width: 40rem) 92vw, 56rem"
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </div>
      ))
    }

    {
      !single && (
        <>
          <button type="button" class="ss-nav ss-prev" aria-label="Previous photo">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M15 5l-7 7 7 7" />
            </svg>
          </button>
          <button type="button" class="ss-nav ss-next" aria-label="Next photo">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </>
      )
    }
  </div>

  <figcaption class="ss-bar">
    <span class="ss-counter">
      <span class="ss-cur">1</span> / <span class="ss-total">{images.length}</span>
    </span>
    <span class="ss-caption" aria-live="polite">{images[0]?.caption ?? ''}</span>
  </figcaption>
</figure>

<style>
  .slideshow {
    max-width: 56rem;
    margin: clamp(1.5rem, 3vw, 2.5rem) auto 0;
  }
  .ss-stage {
    position: relative;
    aspect-ratio: 3 / 2;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    overflow: hidden;
    touch-action: pan-y;
  }
  .ss-stage:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
  }
  .ss-slide {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.45s ease;
  }
  .ss-slide.is-active {
    opacity: 1;
    visibility: visible;
  }
  .ss-slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ss-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    padding: 0;
    background: color-mix(in srgb, var(--paper) 78%, transparent);
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--ink);
    cursor: pointer;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    transition: background-color 0.2s ease, border-color 0.2s ease,
      color 0.2s ease;
  }
  .ss-prev {
    left: 0.7rem;
  }
  .ss-next {
    right: 0.7rem;
  }
  .ss-nav:hover {
    border-color: var(--crema);
    color: var(--crema-deep);
    background: var(--paper);
  }
  .ss-nav svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ss-bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.8rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--faded);
  }
  .ss-counter {
    color: var(--crema-deep);
    white-space: nowrap;
  }
  .ss-caption {
    text-align: right;
    line-height: 1.4;
  }

  @media (prefers-reduced-motion: reduce) {
    .ss-slide {
      transition: none;
    }
  }
</style>

<script>
  function initSlideshow(root: HTMLElement) {
    const slides = Array.from(
      root.querySelectorAll<HTMLElement>('.ss-slide')
    );
    if (slides.length === 0) return;
    const stage = root.querySelector<HTMLElement>('.ss-stage');
    const curEl = root.querySelector<HTMLElement>('.ss-cur');
    const capEl = root.querySelector<HTMLElement>('.ss-caption');
    let i = Math.max(
      0,
      slides.findIndex((s) => s.classList.contains('is-active'))
    );

    function show(n: number) {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => {
        const active = k === i;
        s.classList.toggle('is-active', active);
        s.setAttribute('aria-hidden', active ? 'false' : 'true');
      });
      if (curEl) curEl.textContent = String(i + 1);
      if (capEl) capEl.textContent = slides[i].dataset.caption || '';
    }

    root
      .querySelector('.ss-prev')
      ?.addEventListener('click', () => show(i - 1));
    root
      .querySelector('.ss-next')
      ?.addEventListener('click', () => show(i + 1));

    stage?.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        show(i - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        show(i + 1);
      }
    });

    // Touch / pointer swipe
    let x0: number | null = null;
    stage?.addEventListener('pointerdown', (e: PointerEvent) => {
      x0 = e.clientX;
    });
    stage?.addEventListener('pointerup', (e: PointerEvent) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      x0 = null;
      if (Math.abs(dx) > 40) show(dx < 0 ? i + 1 : i - 1);
    });

    show(i);
  }

  document
    .querySelectorAll<HTMLElement>('.slideshow')
    .forEach(initSlideshow);
</script>
