---
import { getCollection, render } from 'astro:content';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import Slideshow from '../../components/Slideshow.astro';
import { formatDate, isoDate } from '../../lib/date';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, pubDate, updatedDate, tags, gallery } = entry.data;

// Resolve gallery paths (relative to src/assets/notes/) to optimized images.
const galleryModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/notes/**/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const slides = (gallery ?? [])
  .map((g) => {
    const mod = galleryModules[`/src/assets/notes/${g.src}`];
    return mod
      ? { src: mod.default, alt: g.alt ?? `${title} — photograph`, caption: g.caption }
      : null;
  })
  .filter(
    (s): s is { src: ImageMetadata; alt: string; caption?: string } =>
      s !== null
  );
---

<Base title={`${title} — Field Notes`} description={description}>
  <article class="wrap note">
    <a class="back" href="/notes/">
      <span aria-hidden="true">←</span> Field Notes
    </a>

    <header class="note-head">
      <p class="note-meta">
        <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
        {
          tags.length > 0 && (
            <span class="meta-tags">
              {tags.map((t) => (
                <a class="meta-tag" href={`/notes/tags/${t}/`}>
                  #{t}
                </a>
              ))}
            </span>
          )
        }
      </p>
      <h1 class="note-h1">{title}</h1>
      <p class="note-standfirst">{description}</p>
      {
        updatedDate && (
          <p class="note-updated">
            Updated <time datetime={isoDate(updatedDate)}>{formatDate(updatedDate)}</time>
          </p>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      slides.length > 0 && (
        <Slideshow images={slides} label={`${title} — photo gallery`} />
      )
    }

    <footer class="note-foot">
      <a class="back" href="/notes/">
        <span aria-hidden="true">←</span> All field notes
      </a>
    </footer>
  </article>
</Base>

<style>
  .note {
    padding-top: clamp(2rem, 5vw, 3.5rem);
    padding-bottom: var(--rhythm);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.03em;
    color: var(--faded);
    transition: color 0.2s ease;
  }
  .back:hover {
    color: var(--signal);
  }

  .note-head {
    max-width: var(--measure);
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.2rem);
    border-bottom: 1px solid var(--line);
  }
  .note-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--faded);
  }
  .meta-tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
  .meta-tag {
    color: var(--crema-deep);
    transition: color 0.2s ease;
  }
  .meta-tag:hover {
    color: var(--signal);
  }
  .note-h1 {
    font-size: var(--step-4);
    font-weight: 400;
    margin-top: 1rem;
    letter-spacing: -0.02em;
  }
  .note-standfirst {
    max-width: 38rem;
    margin-top: 1.1rem;
    font-family: var(--font-serif);
    font-size: var(--step-1);
    font-style: italic;
    color: var(--ink-soft);
    line-height: 1.5;
  }
  .note-updated {
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    color: var(--faded);
  }

  .note-foot {
    max-width: var(--measure);
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
</style>
