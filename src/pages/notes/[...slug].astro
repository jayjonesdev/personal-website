---
import { getCollection, render } from 'astro:content';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import Slideshow from '../../components/Slideshow.astro';
import Checklist from '../../components/Checklist.astro';
import { checklists } from '../../data/checklists';
import { formatDate, isoDate } from '../../lib/date';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  gallery,
  galleryBefore,
  checklist,
} = entry.data;

const card = checklist ? checklists[checklist] : undefined;
if (checklist && !card) {
  throw new Error(
    `Note "${entry.id}" references checklist "${checklist}", which isn't defined in src/data/checklists.ts.`
  );
}

// Resolve gallery paths (relative to src/assets/notes/) to optimized images.
const galleryModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/notes/**/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const slides = (gallery ?? [])
  .map((g) => {
    const mod = galleryModules[`/src/assets/notes/${g.src}`];
    return mod
      ? { src: mod.default, alt: g.alt ?? `${title} — photograph`, caption: g.caption }
      : null;
  })
  .filter(
    (s): s is { src: ImageMetadata; alt: string; caption?: string } =>
      s !== null
  );

// `galleryBefore` drops the slideshow in ahead of a heading instead of after
// the whole post. That means splitting the rendered HTML rather than using
// <Content />, so it only works for posts without inline Markdown images —
// those are placeholders that only <Content /> can resolve.
let proseBefore: string | null = null;
let proseAfter = '';

if (galleryBefore && slides.length > 0) {
  const html = entry.rendered?.html ?? '';
  const inlineImages = (
    entry.rendered?.metadata as { imagePaths?: string[] } | undefined
  )?.imagePaths;

  if (inlineImages && inlineImages.length > 0) {
    throw new Error(
      `Note "${entry.id}" uses galleryBefore, which can't be combined with images placed inline in the Markdown body. Drop galleryBefore, or move those images into the gallery.`
    );
  }

  const target = galleryBefore.trim().toLowerCase();
  const heading = [
    ...html.matchAll(/<h([1-6])\b[^>]*>([\s\S]*?)<\/h\1>/g),
  ].find(
    (m) => m[2].replace(/<[^>]*>/g, '').trim().toLowerCase() === target
  );

  if (!heading) {
    throw new Error(
      `Note "${entry.id}" sets galleryBefore: "${galleryBefore}", but has no heading with that text.`
    );
  }

  proseBefore = html.slice(0, heading.index);
  proseAfter = html.slice(heading.index);
}
---

<Base title={`${title} — Field Notes`} description={description}>
  <article class="wrap note">
    <a class="back" href="/notes/">
      <span aria-hidden="true">←</span> Field Notes
    </a>

    <header class="note-head">
      <p class="note-meta">
        <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
        {
          tags.length > 0 && (
            <span class="meta-tags">
              {tags.map((t) => (
                <a class="meta-tag" href={`/notes/tags/${t}/`}>
                  #{t}
                </a>
              ))}
            </span>
          )
        }
      </p>
      <h1 class="note-h1">{title}</h1>
      <p class="note-standfirst">{description}</p>
      {
        updatedDate && (
          <p class="note-updated">
            Updated <time datetime={isoDate(updatedDate)}>{formatDate(updatedDate)}</time>
          </p>
        )
      }
    </header>

    {
      proseBefore !== null ? (
        <>
          <div class="prose" set:html={proseBefore} />
          <Slideshow images={slides} label={`${title} — photo gallery`} />
          <div class="prose prose-tail" set:html={proseAfter} />
        </>
      ) : (
        <>
          <div class="prose">
            <Content />
          </div>
          {slides.length > 0 && (
            <Slideshow images={slides} label={`${title} — photo gallery`} />
          )}
        </>
      )
    }

    {card && <Checklist data={card} storageKey={entry.id} />}

    <footer class="note-foot">
      <a class="back" href="/notes/">
        <span aria-hidden="true">←</span> All field notes
      </a>
    </footer>
  </article>
</Base>

<style>
  .note {
    padding-top: clamp(2rem, 5vw, 3.5rem);
    padding-bottom: var(--rhythm);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.03em;
    color: var(--faded);
    transition: color 0.2s ease;
  }
  .back:hover {
    color: var(--signal);
  }

  .note-head {
    max-width: var(--measure);
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.2rem);
    border-bottom: 1px solid var(--line);
  }
  .note-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--faded);
  }
  .meta-tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
  .meta-tag {
    color: var(--crema-deep);
    transition: color 0.2s ease;
  }
  .meta-tag:hover {
    color: var(--signal);
  }
  .note-h1 {
    font-size: var(--step-4);
    font-weight: 400;
    margin-top: 1rem;
    letter-spacing: -0.02em;
  }
  .note-standfirst {
    max-width: 38rem;
    margin-top: 1.1rem;
    font-family: var(--font-serif);
    font-size: var(--step-1);
    font-style: italic;
    color: var(--ink-soft);
    line-height: 1.5;
  }
  .note-updated {
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    color: var(--faded);
  }

  /* Picks up after the slideshow — the first heading's own top margin is
     spacing enough, so don't stack the .prose margin on top of it. */
  .prose-tail {
    margin-top: 0;
  }

  .note-foot {
    max-width: var(--measure);
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
</style>
