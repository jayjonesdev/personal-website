---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import NoteList from '../../../components/NoteList.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  const tags = [...new Set(notes.flatMap((n) => n.data.tags))].sort();

  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      notes: notes
        .filter((n) => n.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag, notes } = Astro.props;
const count = notes.length;
---

<Base
  title={`#${tag} — Field Notes`}
  description={`Field notes tagged “${tag}” by Jerrell Jones.`}
>
  <header class="wrap page-head">
    <a class="back" href="/notes/">
      <span aria-hidden="true">←</span> Field Notes
    </a>
    <p class="eyebrow reveal">Tag</p>
    <h1 class="page-title reveal">#{tag}</h1>
    <p class="page-lede reveal">
      {count} {count === 1 ? 'note' : 'notes'} tagged “{tag}”.
    </p>
  </header>

  <div class="wrap">
    <NoteList notes={notes} />
  </div>
</Base>

<style>
  .page-head {
    padding-top: clamp(2rem, 5vw, 3.5rem);
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--line);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.03em;
    color: var(--faded);
    margin-bottom: 1.4rem;
    transition: color 0.2s ease;
  }
  .back:hover {
    color: var(--signal);
  }
  .page-title {
    font-size: var(--step-4);
    font-weight: 400;
    margin-top: 0.6rem;
    letter-spacing: -0.02em;
  }
  .page-lede {
    max-width: var(--measure);
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: var(--step-0);
    color: var(--faded);
  }
</style>
